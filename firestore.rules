rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Funciones compartidas por todas las colecciones
    // ─────────────────────────────────────────────

    // Administrador de la whitelist.
    function isWhitelistAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true
        || request.auth.token.email == 'admin@ucen.cl'
      );
    }

    // true si quien consulta tiene sesión y su correo es el indicado.
    function isOwner(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    // Registro en la whitelist de quien consulta.
    function requesterEntry() {
      return get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data;
    }

    // true si quien consulta está activo en la whitelist con el rol indicado.
    // El rol no viene en la sesión: se lee de su documento en la whitelist.
    function hasActiveRole(role) {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email))
        && requesterEntry().role == role
        && requesterEntry().status == 'active';
    }

    // ─────────────────────────────────────────────
    // Whitelist de correos autorizados (HU-01)
    // ─────────────────────────────────────────────

    match /whitelist/{email} {
      function hasValidWhitelistData() {
        return request.resource.data.keys().hasAll([
            'email', 'role', 'status', 'addedAt', 'revokedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'email', 'role', 'status', 'addedAt', 'revokedAt'
          ])
          && request.resource.data.email == email
          && request.resource.data.email.matches('^[^@\\s]+@ucen\\.cl$')
          && request.resource.data.role in ['student', 'teacher', 'admin']
          && request.resource.data.status in ['active', 'revoked']
          && request.resource.data.addedAt is string
          && (
            request.resource.data.revokedAt == null
            || request.resource.data.revokedAt is string
          );
      }

      allow get: if isWhitelistAdmin() || isOwner(email);
      // El profesor guía solo puede listar estudiantes (panel docente).
      // Su consulta debe filtrar por role == 'student' o será rechazada.
      allow list: if isWhitelistAdmin()
        || (hasActiveRole('teacher') && resource.data.role == 'student');
      allow create, update: if isWhitelistAdmin() && hasValidWhitelistData();
      allow delete: if isWhitelistAdmin();
    }

    // ─────────────────────────────────────────────
    // Resumen de avance de cada estudiante (panel docente)
    // ─────────────────────────────────────────────

    match /progress/{email} {
      // Avance en el marco teórico.
      function isValidTheory(theory) {
        return theory is map
          && theory.keys().hasAll([
            'isApproved', 'attemptsUsed', 'bestScorePercentage', 'approvedAt'
          ])
          && theory.keys().hasOnly([
            'isApproved', 'attemptsUsed', 'bestScorePercentage', 'approvedAt'
          ])
          && theory.isApproved is bool
          && theory.attemptsUsed is int
          && theory.attemptsUsed >= 0
          && (
            theory.bestScorePercentage == null
            || (
              theory.bestScorePercentage is number
              && theory.bestScorePercentage >= 0
              && theory.bestScorePercentage <= 100
            )
          )
          && (theory.approvedAt == null || theory.approvedAt is string);
      }

      // Avance en un taller.
      function isValidWorkshop(workshop) {
        return workshop is map
          && workshop.keys().hasAll(['attemptsUsed', 'hasDraft'])
          && workshop.keys().hasOnly(['attemptsUsed', 'hasDraft'])
          && workshop.attemptsUsed is int
          && workshop.attemptsUsed >= 0
          && workshop.hasDraft is bool;
      }

      // Los 4 talleres, ni más ni menos.
      function hasValidWorkshops(workshops) {
        return workshops is map
          && workshops.keys().hasAll([
            'workshop-1', 'workshop-2', 'workshop-3', 'workshop-4'
          ])
          && workshops.keys().hasOnly([
            'workshop-1', 'workshop-2', 'workshop-3', 'workshop-4'
          ])
          && isValidWorkshop(workshops['workshop-1'])
          && isValidWorkshop(workshops['workshop-2'])
          && isValidWorkshop(workshops['workshop-3'])
          && isValidWorkshop(workshops['workshop-4']);
      }

      function hasValidProgressData() {
        return request.resource.data.keys().hasAll([
            'email', 'theory', 'workshops', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'email', 'theory', 'workshops', 'updatedAt'
          ])
          && request.resource.data.email == email
          && isValidTheory(request.resource.data.theory)
          && hasValidWorkshops(request.resource.data.workshops)
          && request.resource.data.updatedAt is string;
      }

      // Cada estudiante lee su propio resumen; el profesor guía lee todos.
      allow get: if isOwner(email) || hasActiveRole('teacher');
      allow list: if hasActiveRole('teacher');
      // Solo el propio estudiante escribe su resumen, y solo si sigue activo.
      allow create, update: if isOwner(email)
        && hasActiveRole('student')
        && hasValidProgressData();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // Nombre de cada estudiante (panel docente)
    // ─────────────────────────────────────────────

    match /profiles/{email} {
      // El estudiante lee el suyo; el profesor guía y el admin leen todos.
      allow get: if isOwner(email) || hasActiveRole('teacher') || isWhitelistAdmin();
      allow list: if hasActiveRole('teacher') || isWhitelistAdmin();
      // Por ahora lo carga el administrador (desde la consola, que no pasa
      // por estas reglas). Se deja la escritura solo al admin por si más
      // adelante se hace desde la app.
      allow create, update: if isWhitelistAdmin()
        && request.resource.data.keys().hasOnly(['email', 'name'])
        && request.resource.data.keys().hasAll(['email', 'name'])
        && request.resource.data.email == email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow delete: if isWhitelistAdmin();
    }

    // ─────────────────────────────────────────────
    // Notas y resultados de los talleres (los pone el profesor)
    // ─────────────────────────────────────────────

    match /evaluations/{email} {
      // Evaluación de un taller: nota de 1 a 7 y resultado, ambos opcionales.
      function isValidEvaluation(evaluation) {
        return evaluation is map
          && evaluation.keys().hasAll(['grade', 'outcome', 'evaluatedAt'])
          && evaluation.keys().hasOnly([
            'grade', 'outcome', 'evaluatedAt', 'sourceSubmissionId'
          ])
          && (
            evaluation.grade == null
            || (evaluation.grade is number && evaluation.grade >= 1 && evaluation.grade <= 7)
          )
          && (evaluation.outcome == null || evaluation.outcome in ['approved', 'failed'])
          && (evaluation.evaluatedAt == null || evaluation.evaluatedAt is string)
          && (!('sourceSubmissionId' in evaluation)
            || evaluation.sourceSubmissionId == null
            || (
              evaluation.sourceSubmissionId is string
              && evaluation.sourceSubmissionId.size() <= 200
            ));
      }

      // Cada taller es opcional, pero si viene debe ser válido.
      function hasValidEvaluations(workshops) {
        return workshops is map
          && workshops.keys().hasOnly([
            'workshop-1', 'workshop-2', 'workshop-3', 'workshop-4'
          ])
          && (!('workshop-1' in workshops) || isValidEvaluation(workshops['workshop-1']))
          && (!('workshop-2' in workshops) || isValidEvaluation(workshops['workshop-2']))
          && (!('workshop-3' in workshops) || isValidEvaluation(workshops['workshop-3']))
          && (!('workshop-4' in workshops) || isValidEvaluation(workshops['workshop-4']));
      }

      // El estudiante lee la suya; el profesor guía lee todas.
      allow get: if isOwner(email) || hasActiveRole('teacher');
      allow list: if hasActiveRole('teacher');
      // Solo el profesor guía escribe; el estudiante nunca puede ponerse nota.
      allow create, update: if hasActiveRole('teacher')
        && request.resource.data.keys().hasOnly(['email', 'workshops', 'updatedAt'])
        && request.resource.data.keys().hasAll(['email', 'workshops', 'updatedAt'])
        && request.resource.data.email == email
        && hasValidEvaluations(request.resource.data.workshops)
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // Entregas privadas para revisión de innovaciones (HU-07)
    // ─────────────────────────────────────────────

    match /workshopSubmissions/{submissionId} {
      function canOwnerEditSubmission() {
        let evaluationPath = /databases/$(database)/documents/evaluations/$(resource.data.studentEmail);
        return !exists(evaluationPath)
          || !('workshops' in get(evaluationPath).data)
          || !(resource.data.workshopId in get(evaluationPath).data.workshops)
          || !('sourceSubmissionId' in get(evaluationPath).data.workshops[resource.data.workshopId])
          || get(evaluationPath).data.workshops[resource.data.workshopId].sourceSubmissionId
            != submissionId;
      }

      function hasValidSubmission() {
        return request.resource.data.keys().hasAll([
            'studentUid', 'studentEmail', 'workshopId', 'content', 'responses', 'submittedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'studentUid', 'studentEmail', 'workshopId', 'content', 'responses',
            'submittedAt', 'publishedInnovationId'
          ])
          && request.resource.data.studentUid is string
          && request.resource.data.studentEmail is string
          && request.resource.data.studentEmail == request.auth.token.email
          && request.resource.data.workshopId in [
            'workshop-1', 'workshop-2', 'workshop-3', 'workshop-4'
          ]
          && request.resource.data.content is map
          && request.resource.data.content.keys().hasAll([
            'context', 'description', 'actors', 'relevance'
          ])
          && request.resource.data.content.keys().hasOnly([
            'context', 'description', 'actors', 'relevance'
          ])
          && request.resource.data.content.context is string
          && request.resource.data.content.context.size() <= 12000
          && request.resource.data.content.description is string
          && request.resource.data.content.description.size() <= 12000
          && request.resource.data.content.actors is string
          && request.resource.data.content.actors.size() <= 12000
          && request.resource.data.content.relevance is string
          && request.resource.data.content.relevance.size() <= 12000
          && request.resource.data.responses is list
          && request.resource.data.responses.size() <= 30
          && request.resource.data.submittedAt is string;
      }

      allow get: if hasActiveRole('teacher')
        || (hasActiveRole('student') && resource.data.studentUid == request.auth.uid);
      allow list: if hasActiveRole('teacher');
      allow create: if hasActiveRole('student')
        && request.resource.data.studentUid == request.auth.uid
        && hasValidSubmission();
      allow update: if (
          hasActiveRole('student')
          && resource.data.studentUid == request.auth.uid
          && canOwnerEditSubmission()
          && (!('publishedInnovationId' in resource.data)
            || resource.data.publishedInnovationId == null)
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.studentEmail == resource.data.studentEmail
          && request.resource.data.workshopId == resource.data.workshopId
          && hasValidSubmission()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content', 'responses', 'submittedAt'
          ])
        )
        || (
          hasActiveRole('teacher')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'publishedInnovationId'
          ])
          && request.resource.data.publishedInnovationId is string
        );
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // Catálogo público de trabajos revisados y anonimizados (HU-07)
    // ─────────────────────────────────────────────

    match /publishedInnovations/{innovationId} {
      function isValidPublishedInnovation() {
        return request.resource.data.keys().hasAll([
            'workshopId', 'grade', 'title', 'summary', 'productType', 'work',
            'tags', 'publishedAt', 'approved'
          ])
          && request.resource.data.keys().hasOnly([
            'workshopId', 'grade', 'title', 'summary', 'productType', 'work',
            'tags', 'publishedAt', 'approved'
          ])
          && request.resource.data.workshopId in [
            'workshop-1', 'workshop-2', 'workshop-3', 'workshop-4'
          ]
          && request.resource.data.grade is number
          && request.resource.data.grade >= 6
          && request.resource.data.grade <= 7
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.summary is string
          && request.resource.data.summary.size() > 0
          && request.resource.data.summary.size() <= 1000
          && request.resource.data.productType is string
          && request.resource.data.productType.size() > 0
          && request.resource.data.productType.size() <= 100
          && request.resource.data.work is string
          && request.resource.data.work.size() > 0
          && request.resource.data.work.size() <= 20000
          && request.resource.data.tags is list
          && request.resource.data.tags.size() > 0
          && request.resource.data.tags.size() <= 10
          && request.resource.data.publishedAt is string
          && request.resource.data.approved == true;
      }

      allow get, list: if hasActiveRole('teacher')
        || (
          hasActiveRole('student')
          && resource.data.approved == true
          && resource.data.grade >= 6
        );
      allow create, update: if hasActiveRole('teacher') && isValidPublishedInnovation();
      allow delete: if hasActiveRole('teacher');
    }

    // ─────────────────────────────────────────────
    // Estructura configurable de talleres (HU-09)
    // ─────────────────────────────────────────────

    match /workshopConfigurations/{workshopId} {
      function isValidSection(section) {
        return section is map
          && section.keys().hasOnly(['id', 'enabled', 'order'])
          && section.keys().hasAll(['id', 'enabled', 'order'])
          && section.id in [
            'objectives-context', 'incident-form', 'theory-framework',
            'peer-feedback', 'evaluation-rubric', 'prompt-bank'
          ]
          && section.enabled is bool
          && section.order is int
          && section.order >= 0
          && section.order < 6;
      }

      function hasValidWorkshopConfiguration() {
        return request.resource.data.keys().hasOnly([
            'workshopId', 'answerKeyPrivate', 'sections', 'evaluationType', 'formSchema',
            'updatedAt', 'updatedBy'
          ])
          && request.resource.data.keys().hasAll([
            'workshopId', 'answerKeyPrivate', 'sections', 'evaluationType', 'formSchema',
            'updatedAt', 'updatedBy'
          ])
          && request.resource.data.workshopId == workshopId
          && request.resource.data.answerKeyPrivate == true
          && workshopId in ['workshop-1', 'workshop-2', 'workshop-3', 'workshop-4']
          && request.resource.data.sections is list
          && request.resource.data.sections.size() == 6
          && isValidSection(request.resource.data.sections[0])
          && isValidSection(request.resource.data.sections[1])
          && isValidSection(request.resource.data.sections[2])
          && isValidSection(request.resource.data.sections[3])
          && isValidSection(request.resource.data.sections[4])
          && isValidSection(request.resource.data.sections[5])
          && request.resource.data.evaluationType in [
            'text', 'multiple-choice'
          ]
          && request.resource.data.formSchema is map
          && request.resource.data.formSchema.keys().hasOnly([
            'guidingQuestions', 'matrixRows', 'questions'
          ])
          && request.resource.data.formSchema.keys().hasAll([
            'guidingQuestions', 'matrixRows', 'questions'
          ])
          && request.resource.data.formSchema.guidingQuestions is list
          && request.resource.data.formSchema.guidingQuestions.size() <= 30
          && request.resource.data.formSchema.matrixRows is list
          && request.resource.data.formSchema.matrixRows.size() <= 30
          && request.resource.data.formSchema.questions is list
          && request.resource.data.formSchema.questions.size() <= 30
          && (
            request.resource.data.evaluationType != 'multiple-choice'
            || request.resource.data.formSchema.questions.size() > 0
          )
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedBy == request.auth.token.email;
      }

      // Estudiantes y docentes activos pueden consultar la configuración.
      allow get: if hasActiveRole('teacher')
        || (
          hasActiveRole('student')
          && (
            !exists(/databases/$(database)/documents/workshopConfigurations/$(workshopId))
            || resource.data.answerKeyPrivate == true
          )
        );
      allow list: if hasActiveRole('teacher')
        || (hasActiveRole('student') && resource.data.answerKeyPrivate == true);
      // Solo docentes activos pueden editar o restablecer la plantilla.
      allow create, update: if hasActiveRole('teacher')
        && hasValidWorkshopConfiguration();
      allow delete: if hasActiveRole('teacher');

      match /private/{privateDocument} {
        function hasValidAnswerKey() {
          return request.resource.data.keys().hasOnly([
              'workshopId', 'answers', 'updatedAt', 'updatedBy'
            ])
            && request.resource.data.keys().hasAll([
              'workshopId', 'answers', 'updatedAt', 'updatedBy'
            ])
            && request.resource.data.workshopId == workshopId
            && request.resource.data.answers is map
            && request.resource.data.answers.size() <= 30
            && request.resource.data.updatedAt is string
            && request.resource.data.updatedBy == request.auth.token.email;
        }

        // La pauta con respuestas correctas no se expone a estudiantes.
        allow get, list: if hasActiveRole('teacher');
        allow create, update: if hasActiveRole('teacher')
          && privateDocument == 'answerKey'
          && hasValidAnswerKey();
        allow delete: if hasActiveRole('teacher') && privateDocument == 'answerKey';
      }
    }
  }
}
