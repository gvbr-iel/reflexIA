# ─────────────────────────────────────────────
# ReflexIA — Variables de entorno
# ─────────────────────────────────────────────
# Copia este archivo como .env y reemplaza los placeholders.
# .env NO se commitea (está en .gitignore).

# API key principal de OpenRouter (HU-05: detección de datos sensibles).
# El servicio también tiene una lista de keys de respaldo en
# src/models/sensitiveData.ts → OPENROUTER_API_KEYS.
VITE_OPENROUTER_API_KEY=sk-or-REEMPLAZAR-CON-TU-API-KEY

# Firebase (valores de configuración web del proyecto; no son credenciales privadas).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
